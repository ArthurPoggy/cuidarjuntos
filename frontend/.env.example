# Variáveis de ambiente do app mobile/web (Expo).
# Copie para .env e preencha os valores. NUNCA versione o .env real.
# Variáveis EXPO_PUBLIC_* são embutidas no bundle em build time (ficam
# visíveis no client, não use aqui nada sensível).

# URL base do backend Django (sem barra final, sem /api/v1).
# Produção: https://app.cuidarjuntos.com.br
EXPO_PUBLIC_API_URL=http://localhost:8000

# Id do projeto EAS, usado para registrar push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=
