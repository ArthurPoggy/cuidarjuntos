# Variáveis de ambiente do backend CuidarJuntos
# Copie para .env e preencha os valores. NUNCA versione o .env real.

# Assistente de IA (Anthropic) — usada pela feature do assistente, adicionada
# em PR posterior. Este PR apenas prepara a configuração.
ANTHROPIC_API_KEY=

# Opcional: sobrescreve o modelo Claude usado pelo assistente.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Liga/desliga o assistente de chat. Mantenha desligado ("0") até existir
# consentimento explícito para o envio de dados a um provedor externo.
CHAT_ASSISTANT_ENABLED=0
